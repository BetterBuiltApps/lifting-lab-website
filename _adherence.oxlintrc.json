{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/session/**",
              "ui_kits/ios_app/**",
              "ui_kits/marketing_site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color, use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value, use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nunito|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Nunito, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:amber|make|miss|neutral)$/]",
        "message": "<Badge> tone must be one of 'amber' | 'make' | 'miss' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BadgeToast'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|label|style|key|ref|className|style|children)$/]",
        "message": "<BadgeToast> doesn't accept that prop. Declared props: title, icon, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BigNumberCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|unit|caption|accent|style|key|ref|className|style|children)$/]",
        "message": "<BigNumberCard> doesn't accept that prop. Declared props: number, unit, caption, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|disabled|icon|children|style|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, full, disabled, icon, children, style, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|gradient|make|miss|secondary|plain)$/]",
        "message": "<Button> variant must be one of 'primary' | 'gradient' | 'make' | 'miss' | 'secondary' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:large|medium|small)$/]",
        "message": "<Button> size must be one of 'large' | 'medium' | 'small'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|radius|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: padding, radius, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:card|row)$/]",
        "message": "<Card> radius must be one of 'card' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MakeMissButtons'] > JSXAttribute > JSXIdentifier[name!=/^(?:onMade|onMiss|style|key|ref|className|style|children)$/]",
        "message": "<MakeMissButtons> doesn't accept that prop. Declared props: onMade, onMiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|caption|icon|accessory|chevron|onClick|style|key|ref|className|style|children)$/]",
        "message": "<NavRow> doesn't accept that prop. Declared props: title, caption, icon, accessory, chevron, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseTimelinePhase'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|duration|peakVelocity|key|ref|className|style|children)$/]",
        "message": "<PhaseTimelinePhase> doesn't accept that prop. Declared props: kind, label, duration, peakVelocity."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseTimelinePhase'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:firstPull|transition|secondPull|turnover|catch)$/]",
        "message": "<PhaseTimelinePhase> kind must be one of 'firstPull' | 'transition' | 'secondPull' | 'turnover' | 'catch'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlateStack'] > JSXAttribute > JSXIdentifier[name!=/^(?:kg|count|key|ref|className|style|children)$/]",
        "message": "<PlateStack> doesn't accept that prop. Declared props: kg, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|height|gradient|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: progress, height, gradient, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='gradient'] > Literal[value!=/^(?:progress|amber)$/]",
        "message": "<ProgressBar> gradient must be one of 'progress' | 'amber'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|grade|straightness|smoothness|style|key|ref|className|style|children)$/]",
        "message": "<ScoreRing> doesn't accept that prop. Declared props: total, grade, straightness, smoothness, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:secondary|amber|tertiary)$/]",
        "message": "<SectionLabel> tone must be one of 'secondary' | 'amber' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SetTarget'] > JSXAttribute > JSXIdentifier[name!=/^(?:exercise|weight|unit|reps|setLabel|cue|percentOfPR|loadPerSide|onFilm|onEditWeight|style|key|ref|className|style|children)$/]",
        "message": "<SetTarget> doesn't accept that prop. Declared props: exercise, weight, unit, reps, setLabel, cue, percentOfPR, loadPerSide, onFilm, onEditWeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:values|color|width|height|style|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: values, color, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|accent|size|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, accent, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:medium|large)$/]",
        "message": "<StatCard> size must be one of 'medium' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|size|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:good|caution|imbalanced|none)$/]",
        "message": "<StatusDot> status must be one of 'good' | 'caution' | 'imbalanced' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<TabBarTab> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimerRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:progress|centerText|emphasized|pulsing|size|style|key|ref|className|style|children)$/]",
        "message": "<TimerRing> doesn't accept that prop. Declared props: progress, centerText, emphasized, pulsing, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ToolTile> doesn't accept that prop. Declared props: title, subtitle, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackingQuality'] > JSXAttribute > JSXIdentifier[name!=/^(?:quality|evidence|note|style|key|ref|className|style|children)$/]",
        "message": "<TrackingQuality> doesn't accept that prop. Declared props: quality, evidence, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackingQuality'] > JSXAttribute[name.name='quality'] > Literal[value!=/^(?:good|fair|poor)$/]",
        "message": "<TrackingQuality> quality must be one of 'good' | 'fair' | 'poor'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VelocitySample'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|velocity|key|ref|className|style|children)$/]",
        "message": "<VelocitySample> doesn't accept that prop. Declared props: time, velocity."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeightField'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|value|unit|onChange|style|key|ref|className|style|children)$/]",
        "message": "<WeightField> doesn't accept that prop. Declared props: title, value, unit, onChange, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
