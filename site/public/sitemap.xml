<?xml version="1.0" encoding="UTF-8"?>
<!-- Three real files, not routes. The marketing page's section anchors are
     deliberately absent: they are not separate URLs and listing them would
     claim pages that do not exist. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://liftinglab.app/</loc>
    <!-- No lastmod here: it is stamped onto the built copy at deploy time
         with today's real date, see scripts/prerender.mjs. A hand-written
         date in source is exactly the kind of thing that goes stale the
         first time nobody remembers to bump it. -->
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://liftinglab.app/privacy/</loc>
    <lastmod>2026-08-16</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://liftinglab.app/terms/</loc>
    <lastmod>2026-08-16</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
